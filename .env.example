NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── ELLE (assistente de debates, rota /elle) ─────────
# Só no servidor. NUNCA coloque NEXT_PUBLIC_ nestas variáveis (isso as exporia no navegador).
# Sem as duas primeiras o /elle funciona só em desenvolvimento, em MODO DE DEMONSTRAÇÃO (exemplo fixo, rotulado).
# Em produção, sem elas, a Elle responde "não está disponível" (nunca finge pesquisar).

# IA que lê o print e escreve a análise — https://console.anthropic.com  (defina um limite mensal de gasto lá)
ANTHROPIC_API_KEY=
# Buscador na internet — Tavily (https://tavily.com, tem plano gratuito) ou Brave
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# ELLE_SEARCH_PROVIDER=tavily

# Opcionais
# ELLE_MODEL_READ=claude-haiku-5-5     # leitura do print (padrão: Haiku, o mais barato)
# ELLE_MODEL_WRITE=claude-sonnet-5-5   # análise e resposta (padrão: Sonnet). Qualidade máxima: claude-opus-5-5
# ELLE_MODEL_PERSONALIZE=claude-haiku-5-5  # reescrita da resposta com a opinião da pessoa
# ELLE_MAX_SEARCHES=4                  # buscas na internet por análise (1 a 7)
# ELLE_ENABLED=1                       # 0 desliga a Elle sem novo deploy
# ELLE_DEMO=0                          # 1 força o modo de demonstração (sempre rotulado)
# ELLE_RATE_PER_10MIN=6                # análises por pessoa a cada 10 min
# ELLE_RATE_PER_DAY=30                 # análises por pessoa por dia
# ELLE_MAX_CONCURRENT=6                # análises ao mesmo tempo no servidor
